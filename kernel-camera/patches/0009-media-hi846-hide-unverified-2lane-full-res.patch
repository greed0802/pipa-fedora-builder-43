From: ArchPad project
Subject: [PATCH] media: i2c: hi846: hide unverified full-resolution 2-lane modes

The Xiaomi Pad 6 front camera uses two CSI-2 data lanes.  On this hardware,
3264x1836 and 3264x2448 accept STREAMON but never complete a capture buffer.
Userspace such as libcamera selects 3264x2448 by default and consequently
appears to freeze when switching to the front camera.

Do not advertise those two modes on a two-lane endpoint until their sensor
timings have been validated.  The known-good 1632x1224 and 1280x720 modes
remain available.  Four-lane mode support is unchanged.

--- a/drivers/media/i2c/hi846.c
+++ b/drivers/media/i2c/hi846.c
@@ -1302,8 +1302,7 @@ static const struct hi846_mode supported_modes[] = {
 			.regs = mode_3264x1836_config,
 		},
 		.reg_list_2lane = {
-			.num_of_regs = ARRAY_SIZE(mode_3264x1836_mipi_2lane),
-			.regs = mode_3264x1836_mipi_2lane,
+			.num_of_regs = 0,
 		},
 		.reg_list_4lane = {
 			.num_of_regs = ARRAY_SIZE(mode_3264x1836_mipi_4lane),
@@ -1329,8 +1328,7 @@ static const struct hi846_mode supported_modes[] = {
 			.regs = mode_3264x2448_config,
 		},
 		.reg_list_2lane = {
-			.num_of_regs = ARRAY_SIZE(mode_3264x2448_mipi_2lane),
-			.regs = mode_3264x2448_mipi_2lane,
+			.num_of_regs = 0,
 		},
 		.reg_list_4lane = {
 			.num_of_regs = ARRAY_SIZE(mode_3264x2448_mipi_4lane),
