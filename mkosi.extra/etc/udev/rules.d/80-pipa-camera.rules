# CAMSS / libcamera nodes: video group already; tag so PipeWire can see them.
SUBSYSTEM=="video4linux", KERNEL=="video*", GROUP="video", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="media", KERNEL=="media*", GROUP="video", MODE="0660", TAG+="uaccess"
# qcam/libcamera software ISP allocates from dma-heaps (CMA). 0600 root = silent white preview.
SUBSYSTEM=="dma_heap", GROUP="video", MODE="0660", TAG+="uaccess"
